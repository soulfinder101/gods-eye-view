{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-165,70],[-150,60],[-125,48],[-117,32],[-105,20],[-85,10],[-80,-5],[-75,-30],[-72,-50]]},"properties":{"name":"Pacific Americas Flyway","Leg":"Flyway corridor (centre line)"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-122,44]},"properties":{"name":"Pacific Americas Flyway","Type":"Global flyway","Scale":"~400 migratory species","About":"Alaska and western Canada down the Pacific coast to Central America and the Andes. Key sites include the Copper River Delta, San Francisco Bay and the Gulf of California."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-100,72],[-97,55],[-95,40],[-92,28],[-90,18],[-80,8],[-70,-10],[-62,-30],[-65,-50]]},"properties":{"name":"Central Americas Flyway","Leg":"Flyway corridor (centre line)"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-96,46]},"properties":{"name":"Central Americas Flyway","Type":"Global flyway","Scale":"Mississippi & Central US flyways","About":"Arctic Canada through the Great Plains and Mississippi valley, across the Gulf of Mexico and on to South America. The Platte River and the Texas coast are major stopovers."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-75,75],[-68,60],[-68,45],[-76,35],[-78,22],[-65,10],[-45,-5],[-48,-25],[-60,-40]]},"properties":{"name":"Atlantic Americas Flyway","Leg":"Flyway corridor (centre line)"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-71,40]},"properties":{"name":"Atlantic Americas Flyway","Type":"Global flyway","Scale":"Includes Delaware Bay","About":"The eastern Canadian Arctic down the Atlantic seaboard, through the Caribbean to the northeast coast of South America and on to Patagonia."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-40,72],[-15,64],[-3,55],[-4,45],[-10,30],[-16,15],[-8,5],[10,-15],[18,-33]]},"properties":{"name":"East Atlantic Flyway","Leg":"Flyway corridor (centre line)"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-14,32]},"properties":{"name":"East Atlantic Flyway","Type":"Global flyway","Scale":"~90 million waterbirds","About":"Greenland, Iceland, Scandinavia and Siberia down Europe's Atlantic coast to West and southern Africa. The Wadden Sea and Banc d'Arguin in Mauritania are its two great hubs."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[70,72],[40,60],[30,47],[25,38],[20,25],[15,5],[20,-15],[25,-30]]},"properties":{"name":"Black Sea–Mediterranean Flyway","Leg":"Flyway corridor (centre line)"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[28,44]},"properties":{"name":"Black Sea–Mediterranean Flyway","Type":"Global flyway","Scale":"Bosphorus & Gibraltar bottlenecks","About":"Northern Russia and eastern Europe across the Black Sea and Mediterranean into Africa. Soaring birds funnel over the Bosphorus, Gibraltar and the Strait of Messina."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[90,74],[70,55],[55,42],[45,30],[40,15],[38,0],[33,-20],[28,-30]]},"properties":{"name":"West Asia–East Africa Flyway","Leg":"Flyway corridor (centre line)"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[46,30]},"properties":{"name":"West Asia–East Africa Flyway","Type":"Global flyway","Scale":"Rift Valley route","About":"Western Siberia over the Caspian and the Middle East, down the Red Sea and Rift Valley to East and southern Africa. Eilat and Bab-el-Mandeb see over a million raptors each autumn."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[95,75],[85,55],[78,42],[75,30],[78,15],[80,8]]},"properties":{"name":"Central Asian Flyway","Leg":"Flyway corridor (centre line)"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[80,46]},"properties":{"name":"Central Asian Flyway","Type":"Global flyway","Scale":"Crosses the Himalaya","About":"Arctic Siberia south across Central Asia and over the Himalaya and Hindu Kush to the Indian subcontinent."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-175,68],[160,60],[140,45],[122,35],[110,20],[105,5],[120,-10],[135,-20],[145,-35],[175,-40]]},"properties":{"name":"East Asian–Australasian Flyway","Leg":"Flyway corridor (centre line)"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[120,30]},"properties":{"name":"East Asian–Australasian Flyway","Type":"Global flyway","Scale":"~50 million waterbirds; fastest declining","About":"Arctic Russia and Alaska through East and Southeast Asia to Australia and New Zealand. The Yellow Sea tidal flats are its critical refuelling stop, and their loss has made this the most threatened flyway."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-165,62],[-170,40],[175,10],[170,-10],[178,-18],[175,-38]]},"properties":{"name":"West Pacific Flyway","Leg":"Flyway corridor (centre line)"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-172,22]},"properties":{"name":"West Pacific Flyway","Type":"Global flyway","Scale":"Island-hopping route","About":"Alaska and eastern Siberia across the central Pacific to island groups such as Hawaiʻi, Fiji and New Zealand. Pacific golden plovers and bristle-thighed curlews use it."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-25,72],[-28,50],[-20,20],[-30,-10],[-45,-40],[-45,-66]]},"properties":{"name":"Arctic tern","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-20,20],[8,-10],[12,-30],[18,-45],[20,-66]]},"properties":{"name":"Arctic tern","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-45,-66],[-15,-35],[-30,0],[-42,30],[-25,72]]},"properties":{"name":"Arctic tern","Leg":"Return migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-25,72]},"properties":{"name":"Arctic tern","Species":"Arctic tern (Sterna paradisaea)","Group":"Seabirds","Breeding ground":"Greenland, Iceland & Arctic coasts","Wintering ground":"Weddell Sea pack ice, Antarctica","Distance (km)":"70,000–96,000 round trip","Timing":"Leave Arctic Aug–Sep; Antarctic Nov–Mar; back by May–Jun","Flyway":"East Atlantic","Notes":"The longest migration of any animal. Birds pause in the North Atlantic, then split off West Africa to follow either the African or the South American coast south. They return in a giant S-curve that rides the Atlantic wind systems. Over a 30-year life one tern can fly about 2.4 million km."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-162,61],[-172,40],[178,10],[174.5,-37.2]]},"properties":{"name":"Bar-tailed godwit","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[174.5,-37.2],[150,-15],[124,39.5],[160,55],[-162,61]]},"properties":{"name":"Bar-tailed godwit","Leg":"Return migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-162,61]},"properties":{"name":"Bar-tailed godwit","Species":"Bar-tailed godwit (Limosa lapponica baueri)","Group":"Shorebirds","Breeding ground":"Yukon–Kuskokwim Delta, Alaska","Wintering ground":"Firth of Thames & Farewell Spit, New Zealand","Distance (km)":"~12,000 nonstop south; 13,560 km record","Timing":"Leave Alaska Sep–Oct; NZ Oct–Mar; north via Yellow Sea Mar–May","Flyway":"East Asian–Australasian / West Pacific","Notes":"The longest nonstop flight of any land bird: 8–11 days over the Pacific without food, water or rest. In 2022 a tagged juvenile flew 13,560 km from Alaska to Tasmania in 11 days. The return trip is broken by a refuelling stop on the Yellow Sea mudflats."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[170,-47],[-175,-20],[160,10],[150,40],[180,50],[-130,45],[-125,36]]},"properties":{"name":"Sooty shearwater","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-125,36],[-115,0],[-145,-35],[170,-47]]},"properties":{"name":"Sooty shearwater","Leg":"Return migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[170,-47]},"properties":{"name":"Sooty shearwater","Species":"Sooty shearwater (Ardenna grisea)","Group":"Seabirds","Breeding ground":"New Zealand & Chilean islands","Wintering ground":"North Pacific: off Japan, Alaska or California","Distance (km)":"~64,000 per year","Timing":"Breed Nov–Apr in NZ; North Pacific May–Sep","Flyway":"Pacific Ocean","Notes":"Tagged birds traced a vast figure of eight across the whole Pacific, chasing an endless summer between the two hemispheres. One of the longest migrations recorded electronically."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[148,-41],[165,-20],[150,10],[145,35],[160,50],[-175,58]]},"properties":{"name":"Short-tailed shearwater","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-175,58],[-140,30],[-170,0],[160,-30],[148,-41]]},"properties":{"name":"Short-tailed shearwater","Leg":"Return migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[148,-41]},"properties":{"name":"Short-tailed shearwater","Species":"Short-tailed shearwater (Ardenna tenuirostris)","Group":"Seabirds","Breeding ground":"Bass Strait & Tasmania","Wintering ground":"Bering Sea & Sea of Okhotsk","Distance (km)":"~30,000 per year","Timing":"Breed Sep–Apr; North Pacific May–Sep","Flyway":"Pacific Ocean","Notes":"Australia's most abundant seabird, around 23 million birds. Mass die-offs in the Bering Sea in recent years have been linked to marine heatwaves."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-1.2,60.5],[-20,63],[-45,55],[-65,40],[-80,25],[-90,18],[-92,10],[-85,-5]]},"properties":{"name":"Red-necked phalarope (Shetland)","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-1.2,60.5]},"properties":{"name":"Red-necked phalarope (Shetland)","Species":"Red-necked phalarope (Shetland) (Phalaropus lobatus)","Group":"Seabirds","Breeding ground":"Shetland, Scotland","Wintering ground":"Pacific Ocean off Ecuador & Peru","Distance (km)":"~25,000 round trip","Timing":"Leave Shetland Aug; Pacific Oct–Apr","Flyway":"Atlantic → Pacific","Notes":"In 2014 a 1 g geolocator showed that a Shetland phalarope crossed the Atlantic and North America to winter in the eastern tropical Pacific, a route nobody expected for a European bird."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-97,72],[-90,64],[-83,52],[-75.1,39.1],[-60,20],[-44,-2],[-50,-25],[-64.9,-40.7],[-69.5,-52.6]]},"properties":{"name":"Red knot (rufa)","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-97,72]},"properties":{"name":"Red knot (rufa)","Species":"Red knot (rufa) (Calidris canutus rufa)","Group":"Shorebirds","Breeding ground":"Central Canadian Arctic","Wintering ground":"Tierra del Fuego","Distance (km)":"~15,000 each way","Timing":"Delaware Bay May; Arctic Jun–Jul; Tierra del Fuego Nov–Feb","Flyway":"Atlantic Americas","Notes":"Times its spring stop in Delaware Bay to the horseshoe crab spawning season, nearly doubling its weight on crab eggs in two weeks. The rufa population has fallen by about 75% since the 1980s and is listed as threatened in the US."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[177,62.5],[162,56],[143,45],[130,36],[121.4,32.6],[114,22],[100,13],[97.3,16.8]]},"properties":{"name":"Spoon-billed sandpiper","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[177,62.5]},"properties":{"name":"Spoon-billed sandpiper","Species":"Spoon-billed sandpiper (Calidris pygmaea)","Group":"Shorebirds","Breeding ground":"Chukotka coast, Russia","Wintering ground":"Gulf of Martaban, Myanmar & Bangladesh coast","Distance (km)":"~8,000 each way","Timing":"Breed Jun–Jul; winter Nov–Mar","Flyway":"East Asian–Australasian","Notes":"Critically endangered, with only a few hundred pairs left. Relies on Yellow Sea mudflats such as Rudong in Jiangsu as a migration stop, and on a captive-breeding programme in the UK and Russia."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[14,61],[18,45],[20,25],[22,5]]},"properties":{"name":"Great snipe","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[14,61]},"properties":{"name":"Great snipe","Species":"Great snipe (Gallinago media)","Group":"Shorebirds","Breeding ground":"Swedish mountains","Wintering ground":"Central Africa (Congo Basin)","Distance (km)":"~6,800 nonstop","Timing":"Leave Sweden Aug–Sep","Flyway":"Black Sea–Mediterranean","Notes":"Holds the speed record for nonstop migration: up to 97 km/h ground speed sustained over 6,800 km in about three days, without using wind assistance. It flies on stored fat alone."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[128,48],[118,30],[94.2,25.9],[75,16],[60,8],[42,-2],[28,-26]]},"properties":{"name":"Amur falcon","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[28,-26],[35,-5],[48,10],[70,25],[90,35],[128,48]]},"properties":{"name":"Amur falcon","Leg":"Return migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[128,48]},"properties":{"name":"Amur falcon","Species":"Amur falcon (Falco amurensis)","Group":"Raptors","Breeding ground":"Amur region, NE China & Mongolia","Wintering ground":"Southern Africa grasslands","Distance (km)":"~22,000 round trip","Timing":"Nagaland stopover Oct–Nov; Africa Dec–Mar","Flyway":"Central Asian → Indian Ocean","Notes":"Gathers by the hundreds of thousands in Nagaland, India, then crosses the Arabian Sea in a nonstop sea crossing of about 4,000 km, the longest regular sea crossing by a raptor. Mass hunting in Nagaland was stopped by a community conservation programme from 2013."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-110,50],[-104,36],[-98.5,25],[-96.5,19.5],[-92,16],[-85,12],[-80,8.8],[-75,5],[-66,-12],[-63,-34]]},"properties":{"name":"Swainson's hawk","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-110,50]},"properties":{"name":"Swainson's hawk","Species":"Swainson's hawk (Buteo swainsoni)","Group":"Raptors","Breeding ground":"Great Plains of Canada & the US","Wintering ground":"Pampas of Argentina","Distance (km)":"~10,000 each way","Timing":"South Sep–Nov; Argentina Dec–Feb","Flyway":"Central Americas","Notes":"Travels in huge flocks called kettles, riding thermals. Almost the whole population funnels through Veracruz, Mexico, where the autumn River of Raptors count tops 4 million birds of several species."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-70,44],[-80,26],[-75,20],[-67,8],[-62,-5]]},"properties":{"name":"Osprey","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-4,57],[-7,38],[-12,25],[-15,14]]},"properties":{"name":"Osprey","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-70,44]},"properties":{"name":"Osprey","Species":"Osprey (Pandion haliaetus)","Group":"Raptors","Breeding ground":"Maine & New England; Scotland","Wintering ground":"Amazon basin; Senegal & The Gambia","Distance (km)":"~4,000–7,000 each way","Timing":"South Aug–Oct; north Mar–Apr","Flyway":"Atlantic Americas / East Atlantic","Notes":"Two well-tracked populations shown here. American birds island-hop through Cuba and Hispaniola; Scottish birds cross Spain and the Sahara to West Africa. Young ospreys stay in Africa or South America for their first 18 months."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[8,52],[-1,42],[-5.6,36],[-5,25],[-2,14]]},"properties":{"name":"White stork","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[20,52],[29,41],[35,32],[33,15],[36,0],[30,-25]]},"properties":{"name":"White stork","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[8,52]},"properties":{"name":"White stork","Species":"White stork (Ciconia ciconia)","Group":"Cranes, storks & geese","Breeding ground":"Germany & Poland","Wintering ground":"Sahel (west route); East & southern Africa (east route)","Distance (km)":"~4,000–10,000 each way","Timing":"South Aug–Sep; back Feb–Apr","Flyway":"East Atlantic / Black Sea–Mediterranean","Notes":"A soaring bird that avoids long sea crossings, so it splits at a migratory divide: western birds cross at Gibraltar, eastern birds at the Bosphorus and through the Levant. Growing numbers now winter on rubbish tips in Spain instead of crossing to Africa."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-113,59.5],[-108,52],[-99,40],[-97,33],[-96.8,28.2]]},"properties":{"name":"Whooping crane","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-113,59.5]},"properties":{"name":"Whooping crane","Species":"Whooping crane (Grus americana)","Group":"Cranes, storks & geese","Breeding ground":"Wood Buffalo National Park, Canada","Wintering ground":"Aransas National Wildlife Refuge, Texas","Distance (km)":"~4,000 each way","Timing":"South Sep–Nov; Texas Nov–Mar; north Mar–May","Flyway":"Central Americas","Notes":"Fell to just 15 birds in 1941. The only self-sustaining wild flock now numbers over 500 and still follows the same single route between Alberta and the Texas coast."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[176,66],[-160,65],[-147,64],[-118,56],[-104,48],[-99,40.7],[-102,34],[-106.9,33.8]]},"properties":{"name":"Sandhill crane","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[176,66]},"properties":{"name":"Sandhill crane","Species":"Sandhill crane (Antigone canadensis)","Group":"Cranes, storks & geese","Breeding ground":"Siberia, Alaska & Arctic Canada","Wintering ground":"New Mexico, Texas & northern Mexico","Distance (km)":"Up to ~8,000 each way","Timing":"Platte River Mar–Apr; south Sep–Nov","Flyway":"Central Americas","Notes":"Over 600,000 cranes, around 80% of the species, gather on Nebraska's Platte River each March. Some lesser sandhills breed as far west as eastern Siberia."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[25,63],[14,54.5],[4.7,48.6],[-6,39]]},"properties":{"name":"Common crane","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[25,63]},"properties":{"name":"Common crane","Species":"Common crane (Grus grus)","Group":"Cranes, storks & geese","Breeding ground":"Finland & Scandinavia","Wintering ground":"Extremadura, Spain","Distance (km)":"~3,500 each way","Timing":"Rügen staging Sep–Oct; Spain Nov–Feb","Flyway":"East Atlantic","Notes":"Western European birds stage in huge numbers at Rügen in Germany and Lac du Der in France. Eastern birds take a separate route through Hungary to Ethiopia."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[100,48],[86,42],[78,35],[75,30],[72.5,27.4]]},"properties":{"name":"Demoiselle crane","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[100,48]},"properties":{"name":"Demoiselle crane","Species":"Demoiselle crane (Grus virgo)","Group":"Cranes, storks & geese","Breeding ground":"Mongolia & Kazakhstan steppe","Wintering ground":"Rajasthan & Gujarat, India","Distance (km)":"~5,000 each way","Timing":"Khichan, Rajasthan Sep–Mar","Flyway":"Central Asian","Notes":"Crosses the Himalaya at altitudes near 8,000 m by some accounts. Up to 20,000 are fed by villagers each winter at Khichan in Rajasthan."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[100,48],[94,38],[90,31],[87.5,27.8],[84,25]]},"properties":{"name":"Bar-headed goose","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[100,48]},"properties":{"name":"Bar-headed goose","Species":"Bar-headed goose (Anser indicus)","Group":"Cranes, storks & geese","Breeding ground":"Mongolia & the Tibetan Plateau","Wintering ground":"Plains of northern India & Assam","Distance (km)":"~1,500–4,000 each way","Timing":"Cross the Himalaya Oct–Nov and Mar–Apr","Flyway":"Central Asian","Notes":"Flies over the Himalaya in a single push. GPS tracking found most birds cross through passes at 5,000–6,000 m and follow the terrain closely, with a highest recorded altitude of 7,290 m."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-97,68],[-97,50],[-93.5,29.8]]},"properties":{"name":"Snow goose","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-97,68]},"properties":{"name":"Snow goose","Species":"Snow goose (Anser caerulescens)","Group":"Cranes, storks & geese","Breeding ground":"Arctic Canada (Queen Maud Gulf)","Wintering ground":"Texas & Louisiana Gulf coast","Distance (km)":"~5,000 each way","Timing":"South Oct–Nov; north Feb–Apr","Flyway":"Central Americas","Notes":"Numbers have grown to over 15 million, so many that they now damage their own Arctic breeding marshes. Spring flocks of hundreds of thousands stop in Missouri and Nebraska."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-79,45],[-85,36],[-88,30.5],[-89.5,21],[-86,14],[-84,10]]},"properties":{"name":"Ruby-throated hummingbird","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-79,45]},"properties":{"name":"Ruby-throated hummingbird","Species":"Ruby-throated hummingbird (Archilochus colubris)","Group":"Songbirds & small landbirds","Breeding ground":"Eastern North America","Wintering ground":"Southern Mexico to Costa Rica","Distance (km)":"~800 nonstop over the Gulf","Timing":"South Aug–Oct; north Mar–May","Flyway":"Central Americas","Notes":"Weighs about 3 g, yet many cross the Gulf of Mexico in one 18–22 hour flight. It nearly doubles its body weight in fat before departure."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-150,64],[-110,58],[-80,48],[-69,43],[-63,30],[-65,18],[-66,10],[-62,3]]},"properties":{"name":"Blackpoll warbler","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-150,64]},"properties":{"name":"Blackpoll warbler","Species":"Blackpoll warbler (Setophaga striata)","Group":"Songbirds & small landbirds","Breeding ground":"Boreal forest, Alaska to Newfoundland","Wintering ground":"Northern South America","Distance (km)":"~2,500 nonstop over the Atlantic","Timing":"Leave New England coast Sep–Oct","Flyway":"Atlantic Americas","Notes":"A 12 g songbird that flies nonstop from New England or Nova Scotia across the open Atlantic to the Caribbean in up to three days. Birds from Alaska first cross the whole continent eastward."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-150,67],[140,65],[80,50],[50,30],[38,0]]},"properties":{"name":"Northern wheatear","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-70,66],[-45,62],[-10,52],[-5,40],[-12,15]]},"properties":{"name":"Northern wheatear","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-150,67]},"properties":{"name":"Northern wheatear","Species":"Northern wheatear (Oenanthe oenanthe)","Group":"Songbirds & small landbirds","Breeding ground":"Alaska; Baffin Island & Greenland","Wintering ground":"East Africa; West Africa","Distance (km)":"~14,500 each way (Alaska)","Timing":"Leave Arctic Aug; Africa Oct–Mar","Flyway":"Cross-hemisphere","Notes":"Two routes from the same species. Alaskan birds cross Siberia and Central Asia to Kenya. Canadian and Greenland birds cross the North Atlantic to Europe before heading to West Africa. Both travel over 14,000 km, among the longest for a songbird."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-2,53],[-5,36],[3,15],[15,-5],[25,-29]]},"properties":{"name":"Barn swallow (European)","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-2,53]},"properties":{"name":"Barn swallow (European)","Species":"Barn swallow (European) (Hirundo rustica)","Group":"Songbirds & small landbirds","Breeding ground":"Britain & western Europe","Wintering ground":"South Africa","Distance (km)":"~10,000 each way","Timing":"South Sep–Oct; back Mar–Apr","Flyway":"East Atlantic","Notes":"British swallows ring-recovered in South Africa were among the first proofs of long-distance migration in the early 20th century. They feed on insects in flight the whole way."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[10,55],[0,40],[5,15],[22,-5],[30,-15]]},"properties":{"name":"Common swift","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[10,55]},"properties":{"name":"Common swift","Species":"Common swift (Apus apus)","Group":"Songbirds & small landbirds","Breeding ground":"Europe","Wintering ground":"Congo Basin & southern Africa","Distance (km)":"~8,000 each way","Timing":"Europe May–Aug; Africa Sep–Apr","Flyway":"East Atlantic / Med.","Notes":"Stays airborne for up to 10 months without landing, eating, drinking and sleeping on the wing."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-1,52],[10,44],[16,15],[18,-1]]},"properties":{"name":"Common cuckoo","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-1,52]},"properties":{"name":"Common cuckoo","Species":"Common cuckoo (Cuculus canorus)","Group":"Songbirds & small landbirds","Breeding ground":"Britain & Europe","Wintering ground":"Congo Basin rainforest","Distance (km)":"~8,000 each way","Timing":"Adults leave Jun–Jul; young follow alone Aug–Sep","Flyway":"Black Sea–Mediterranean","Notes":"Young cuckoos are raised by other species and migrate alone to Africa, finding wintering grounds they have never seen. BTO satellite tracking showed adults use routes via Italy or Spain."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-95,47],[-80,30],[-75,20],[-67,10],[-62,-35]]},"properties":{"name":"Bobolink","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-95,47]},"properties":{"name":"Bobolink","Species":"Bobolink (Dolichonyx oryzivorus)","Group":"Songbirds & small landbirds","Breeding ground":"Northern prairies & hayfields of North America","Wintering ground":"Pampas of Argentina, Bolivia & Paraguay","Distance (km)":"~20,000 round trip","Timing":"South Aug–Oct; north Apr–May","Flyway":"Atlantic Americas","Notes":"One of the longest songbird migrations in the Americas. Hay-mowing during the nesting season has driven steep declines on its breeding grounds."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-88,42],[-90,30],[-88,17],[-84,12],[-62,-3]]},"properties":{"name":"Purple martin","Leg":"Outbound migration"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-88,42]},"properties":{"name":"Purple martin","Species":"Purple martin (Progne subis)","Group":"Songbirds & small landbirds","Breeding ground":"Eastern North America","Wintering ground":"Amazon Basin, Brazil","Distance (km)":"~8,000 each way","Timing":"South Aug–Sep; north Feb–Apr","Flyway":"Central Americas","Notes":"In the east it nests almost entirely in human-made martin houses and gourds. Geolocators showed some birds cover the whole trip in under two weeks."}}
