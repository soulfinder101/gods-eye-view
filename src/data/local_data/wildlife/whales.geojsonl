{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-135.5,57.5],[-148,42],[-156.5,20.8]]},"properties":{"name":"Humpback whale · Alaska to Hawaiʻi","Leg":"Migration route"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-135.5,57.5]},"properties":{"name":"Humpback whale · Alaska to Hawaiʻi","Species":"Humpback whale (Megaptera novaeangliae)","Population":"Hawaiʻi DPS (North Pacific)","Feeding / summer ground":"Southeast Alaska & northern BC","Breeding / winter ground":"Main Hawaiian Islands","Distance (km)":"~4,800 one way","Timing":"Leave Alaska Oct–Dec; in Hawaiʻi Dec–Apr, peak Feb–Mar; back north by May","Abundance":"~11,000","Status":"Not at risk (delisted 2016)","Confidence":"Well documented","Notes":"One of the fastest known baleen-whale migrations; photo-ID shows some whales cross the open Pacific in under 40 days. Males sing on the breeding grounds."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-133.5,54.5],[-128,47],[-124.8,40],[-121,32],[-113,23],[-110.9,18.8]]},"properties":{"name":"Humpback whale · British Columbia to Mexico","Leg":"Migration route"}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-113,23],[-105.6,20.6]]},"properties":{"name":"Humpback whale · British Columbia to Mexico","Leg":"Migration route"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-133.5,54.5]},"properties":{"name":"Humpback whale · British Columbia to Mexico","Species":"Humpback whale (Megaptera novaeangliae)","Population":"Mexico DPS","Feeding / summer ground":"BC, Washington, Oregon, California","Breeding / winter ground":"Pacific Mexico & Revillagigedo Islands","Distance (km)":"~4,000–5,000 one way","Timing":"Feed May–Oct; breed Dec–Apr off Baja, Jalisco and Nayarit","Abundance":"~3,000","Status":"Threatened (US ESA)","Confidence":"Well documented","Notes":"Whales from this segment mix with Hawaiian and Central American whales on shared feeding grounds, then split to separate breeding areas."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[-125,44],[-122.8,36],[-117.5,31],[-110.5,21.5],[-106,18],[-98,15],[-91,13],[-86.2,10]]},"properties":{"name":"Humpback whale · California to Central America","Leg":"Migration route"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[-125,44]},"properties":{"name":"Humpback whale · California to Central America","Species":"Humpback whale (Megaptera novaeangliae)","Population":"Central America DPS","Feeding / summer ground":"California & Oregon coast","Breeding / winter ground":"Guatemala to Panama (Pacific side)","Distance (km)":"~5,000+ one way","Timing":"Feed Jun–Nov; breed Dec–Apr","Abundance":"~1,500","Status":"Endangered (US ESA)","Confidence":"Well documented","Notes":"The smallest and most threatened of the eastern North Pacific humpback segments, with heavy exposure to ship strikes and crab-gear entanglement off California."}}
{"type":"Feature","geometry":{"type":"LineString","coordinates":[[166,55],[158,46],[148,36],[142.2,27.1],[133,26.2],[127.8,26.5],[122,19.5]]},"properties":{"name":"Humpback whale · Russian Far East to Okinawa & Philippines","Leg":"Migration route"}}
{"type":"Feature","geometry":{"type":"Point","coordinates":[166,55]},"properties":{"name":"Humpback whale · Russian Far East to Okinawa & Philippines","Species":"Humpback whale (Megaptera novaeangliae)","Population":"Western North Pacific DPS","Feeding / summer ground":"Commander Islands, Kamchatka, Bering Sea","Breeding / winter ground":"Ogasawara, Okinawa, northern Philippines","Distance (km)":"~3,500–4,500 one way","Timing":"Feed Jun–Oct; breed Jan–Apr","Abundance":"~1,000","Status":"Endangered (US ESA)","Confidence":"Well documented","Notes":"Breeding areas are linked by photo-ID; some feeding grounds for this segment are still unidentified."}}
